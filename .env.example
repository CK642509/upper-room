# --- Sanity connection ---
# Copy this file to `.env` for local development.
# Switch SANITY_DATASET to control which dataset the site reads from:
#   development = test data (use locally)
#   production  = live data (use for the deployed site)

SANITY_PROJECT_ID=k6yyg6ms
SANITY_DATASET=development
SANITY_API_VERSION=2025-01-01

# Sanity CDN: true = cached & fast (recommended in production),
# false = always fresh, no cache (recommended in local dev).
SANITY_USE_CDN=false

# --- Site identity ---
# Absolute origin of the deployed site. Used for the sitemap, canonical URLs
# and og:url tags. Defaults to the production domain when unset; override on
# preview deployments so shared links point at the right host.
NUXT_PUBLIC_SITE_URL=https://www.upperroom.tw

# --- Google Maps ---
# JS API key for the room-detail area map (English labels via language=en).
# Create in GCP Console with Maps JavaScript API enabled, and RESTRICT it:
# HTTP referrers (the site's domains + localhost:3000) and API restriction to
# Maps JavaScript API only — the key ships to the browser and an unrestricted
# key can be abused against your billing. Empty = map shows a placeholder.
NUXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Homepage hero video ---
# Absolute URL of the compressed (~4MB, 720p, muted) hero background video.
# The file is too big for the git repo / Vercel, so it lives on external
# storage — Cloudflare R2 with a public bucket is the intended home (free
# egress; enable public access or a custom domain on the bucket and paste the
# file URL here). Empty = the hero shows the static poster (/hero-poster.jpg).
# For local dev you can drop the encoded .mp4 into public/ (it's gitignored)
# and point this at /hero-video-720p.mp4.
NUXT_PUBLIC_HERO_VIDEO_URL=
