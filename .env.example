# --- Sanity connection ---
# Copy this file to `.env` for local development.
# Switch SANITY_DATASET to control which dataset the site reads from:
#   development = test data (use locally)
#   production  = live data (use for the deployed site)

SANITY_PROJECT_ID=k6yyg6ms
SANITY_DATASET=development
SANITY_API_VERSION=2025-01-01

# Sanity CDN: true = cached & fast (recommended in production),
# false = always fresh, no cache (recommended in local dev).
SANITY_USE_CDN=false
